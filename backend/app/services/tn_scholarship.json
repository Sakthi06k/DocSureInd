{
  "id": "tn_post_matric_scholarship_bc",
  "name": "Tamil Nadu Post-Matric Scholarship for BC/MBC/DNC Students",
  "department": "Backward Classes, Most Backward Classes and Minorities Welfare Department",
  "scope": "Tamil Nadu",
  "status": "VERIFIED",
  "version": "1.0.0",
  "verified_on": "2026-08-23",
  "effective_from": "2026-06-01",
  "supported_scenarios": [
    "BC/MBC/DNC students studying in Tamil Nadu",
    "Post-Matric scholarship scheme applicants"
  ],
  "unsupported_scenarios": [
    "Other caste category students (SC/ST/General)",
    "Pre-Matric scholarship scheme applicants",
    "Students studying outside Tamil Nadu"
  ],
  "questionnaire": [],
  "document_types": {
    "income_certificate": {
      "label": "Income Certificate",
      "critical_fields": ["holder_name", "certificate_number", "annual_income"]
    },
    "community_certificate": {
      "label": "Community Certificate",
      "critical_fields": ["holder_name", "certificate_number", "community"]
    },
    "student_id": {
      "label": "Student ID Card",
      "critical_fields": ["holder_name", "institution_name"]
    },
    "bank_passbook": {
      "label": "Bank Passbook",
      "critical_fields": ["bank_account_holder", "bank_account_last4", "ifsc"]
    }
  },
  "validity_rules": [
    {
      "document": "income_certificate",
      "expiry_field": "expiry_date"
    }
  ],
  "comparison_rules": [
    {
      "field": "holder_name",
      "documents": [
        "income_certificate",
        "community_certificate",
        "student_id"
      ],
      "match": "fuzzy",
      "threshold": 0.88
    }
  ],
  "manual_review_threshold": 0.80,
  "rules": [
    {
      "rule_id": "scholarship_mandatory_documents",
      "title": "Mandatory Scholarship Certificates",
      "operator": "all_of",
      "documents": ["income_certificate", "community_certificate", "student_id", "bank_passbook"],
      "severity_if_missing": "error",
      "source_ids": ["tn_scholarship_source_001"]
    }
  ],
  "official_source_ids": ["tn_scholarship_source_001"]
}
